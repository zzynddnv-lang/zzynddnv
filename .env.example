# ============ MAJBURIY ============
# Telegram Bot tokeni (@BotFather dan)
BOT_TOKEN=bu_yerga_bot_tokenini_yozing

# Groq API kaliti (https://console.groq.com/keys)
GROQ_API_KEY=bu_yerga_groq_api_kalitini_yozing

# Bot egasi / menejerlar Telegram ID si. Faqat shular admin buyruqlari va bildirishnomalarni oladi.
# Bilish uchun: botga /start yuboring. Bir nechta bo'lsa: 111,222
OWNER_ID=

# Lidlar guruhi: har bir mijoz kartochkasi (kontakt olinganda) va hodisalar shu guruhga keladi.
# Botni guruhga qo'shing, guruhda /chatid yuboring (masalan -1001234567890). Bo'sh bo'lsa - OWNER_ID ga.
LIDLAR_CHAT_ID=

# Baza zaxirasi (Render Free'da disk har deployda o'chadi - baza shu chatdagi pin qilingan nusxadan tiklanadi).
# Alohida yopiq guruh tavsiya etiladi (bot ADMIN bo'lishi kerak - pin qilish uchun).
# Bo'sh bo'lsa - birinchi OWNER_ID ning bot bilan shaxsiy chati. 0 - zaxiralash o'chirilgan.
ZAXIRA_CHAT_ID=

# Ombor mas'uli yoki ombor guruhi chat ID si - narx so'rovlari shu yerga keladi.
# Guruh uchun: botni guruhga qo'shing, guruhda /chatid yuboring (masalan -1001234567890).
# Bo'sh bo'lsa - so'rovlar OWNER_ID ga keladi.
SKLAD_CHAT_ID=

# ============ KOMPANIYA VA SOTUV ============
KOMPANIYA_NOMI=UMATIC
# Narx rejimi: 0 - narxsiz PDF tijorat taklifi (narxni menejer bildiradi, standart)
#              1 - ombor narx kiritadi, taklif narx va to'lov sharti bilan yuboriladi
NARX_OMBORDAN=0
# Summa shundan OSHSA - qisman oldindan to'lov (so'm)
KATTA_BUYURTMA_CHEGARASI=100000000
# Katta buyurtmada oldindan to'lov foizi (qolgani - ombordan olib chiqishdan oldin)
OLDINDAN_TOLOV_FOIZI=50
# Tijorat taklifi necha kun amal qiladi
TAKLIF_MUDDATI_KUN=3
# Narx izohi, masalan: QQS bilan (bo'sh bo'lsa ko'rsatilmaydi)
NARX_IZOHI=

# ============ AI ============
# gpt-oss-120b - Groq production modeli, tillarni eng to'g'ri ushlaydi
MODEL=openai/gpt-oss-120b
FALLBACK_MODELS=qwen/qwen3.8-27b

# ============ CRM ============
# Ixtiyoriy: Google Sheets Apps Script webhook havolasi (google_apps_script.gs ga qarang). Hozircha shart emas.
GOOGLE_SHEET_WEBHOOK_URL=

# ============ IXTIYORIY ============
# Vaqt mintaqasi (server UTC da ishlaydi)
# TIMEZONE=Asia/Tashkent
# Mijoz ketma-ket yozgan xabarlarini yig'ib, bitta javob berish uchun kutish (soniya)
# XABAR_KUTISH=4
# Bitta javob uchun AI so'rovlari chegarasi (token tejash)
# MAX_AI_CHAQIRUV=4
# Baza zaxirasi oralig'i (daqiqa)
# ZAXIRA_ORALIQ=5
# Ombor javob bermasa necha daqiqadan keyin eslatish
# SKLAD_ESLATMA_DAQIQA=30
# Taklifga mijoz javob bermasa necha soatdan keyin menejerga eslatish
# KUZATISH_SOAT=6
# Baza va CSV fayllari manzili (doimiy disk ulangan serverlar uchun)
# DB_PATH=/var/data/yordamchi_bot.db
# CSV_PATH=/var/data/leadlar.csv
