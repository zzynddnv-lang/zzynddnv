# Telegram Bot tokeni (@BotFather dan)
BOT_TOKEN=bu_yerga_bot_tokenini_yozing

# Groq API kaliti (https://console.groq.com/keys)
GROQ_API_KEY=bu_yerga_groq_api_kalitini_yozing

# Bot egasining Telegram ID si (MAJBURIY TAVSIYA: faqat shu ID admin buyruqlari va dosyelarni oladi)
# Bilish uchun: botga /start yuboring - javobda ID ko'rsatiladi. Bir nechta bo'lsa: 111,222
OWNER_ID=

# Bot egasining ismi
EGA_ISMI=Zuxriddin

# Groq modeli va zaxira modellar (vergul bilan)
MODEL=qwen/qwen3.8-27b
FALLBACK_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b

# Google Sheets Apps Script webhook havolasi (google_apps_script.gs ga qarang). Ixtiyoriy.
GOOGLE_SHEET_WEBHOOK_URL=

# Ixtiyoriy: baza va CSV fayllari manzili (doimiy disk ulangan serverlar uchun)
# DB_PATH=/var/data/yordamchi_bot.db
# CSV_PATH=/var/data/leadlar.csv
